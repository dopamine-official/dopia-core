{
  "name": "@dopia/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "npm run check:i18n && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run check:i18n && npm run typecheck && npm test",
    "dev:server": "NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_API_MODE=server NEXT_PUBLIC_LOGIN=oauth API_UPSTREAM=http://127.0.0.1:8080 next dev --hostname 127.0.0.1",
    "test:e2e:server": "NEXT_PUBLIC_API_MODE=server API_UPSTREAM=http://127.0.0.1:8080 playwright test"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-logs": "^3.1.0",
    "@tanstack/react-query": "5.100.14",
    "idb": "8.0.0",
    "msw": "2.14.6",
    "next": "16.2.6",
    "posthog-js": "^1.447.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.41",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=20.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@10.28.2"
}
